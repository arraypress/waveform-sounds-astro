{
  "name": "@arraypress/waveform-sounds-astro",
  "version": "0.2.0",
  "description": "Astro component wrapper for @arraypress/waveform-sounds — a server-rendered, searchable, filterable sound list with typed props and ClientRouter support.",
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./WaveformSounds.astro": "./src/WaveformSounds.astro",
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "astro",
    "astro-component",
    "audio",
    "waveform",
    "samples",
    "sample-pack",
    "sound-browser",
    "preview",
    "presets",
    "player",
    "filter",
    "search",
    "music",
    "sound",
    "withastro"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/waveform-sounds-astro.git"
  },
  "bugs": {
    "url": "https://github.com/arraypress/waveform-sounds-astro/issues"
  },
  "homepage": "https://waveformplayer.com",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/arraypress"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@arraypress/waveform-player": "^1.24.5",
    "@arraypress/waveform-sounds": "^0.2.0",
    "astro": "^6.0.0 || ^7.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arraypress/waveform-player": "^1.29.1",
    "@arraypress/waveform-sounds": "^0.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.5",
    "astro": "^7.3.6",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
